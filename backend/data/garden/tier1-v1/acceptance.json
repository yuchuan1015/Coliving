  "shared_cases": [
    {
      "id": "harvest_wins_race",
      "given": "同一成熟批200g，agent先採收",
      "expected": "agent+200g；稍後user偷取拒絕，無入帳"
    },
    {
      "id": "theft_wins_race",
      "given": "同一成熟批200g，user先偷",
      "expected": "user+100g，待agent採收剩餘100g；合計200g"
    },
    {
      "id": "public_identity_split",
      "given": "本批200g，user1照顧3次、agent1照顧1次、user2照顧1次",
      "expected": "三個身分各200/3g；同戶不合併，次數不加權，重試不重發"
    },
    {
      "id": "public_contributors_reset",
      "given": "前批有user1，本批只有agent2照顧",
      "expected": "本批只分agent2；user1不沿用前批資格"
    },
    {
      "id": "public_simultaneous_batches",
      "given": "同tick兩批各200g成熟，當前貢獻者三人",
      "expected": "同交易兩批各按原三人均分，完成後重置一次；不能第一批分完即清資格讓第二批無人可分"
    },
    {
      "id": "public_no_contributors",
      "given": "成熟批200g但本批沒有合格照顧者",
      "expected": "系統採收，200g記未分配損失，無私人入帳或圖鑑進度"
    },
    {
      "id": "public_stale_view_water",
      "given": "同一種植中兩個身分都看到缺水並先後澆水",
      "expected": "兩人均記有效照顧；水分只補到目標，不重複堆疊積水"
    },
    {
      "id": "private_user_permissions",
      "given": "user請求種植、除蟲、施肥或採收",
      "expected": "拒絕；user仍可澆水、偷成熟批與共同清除面板"
    },
    {
      "id": "actor_spoofing",
