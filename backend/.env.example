# 僅供獨立開發／練習場；不要複製正式站 .env 或正式資料。
# JWT_SECRET 請用 python -c 'import secrets; print(secrets.token_urlsafe(48))' 產生。
JWT_SECRET=
DATABASE_URL=sqlite:///./coliving.db
CORS_ORIGINS=http://127.0.0.1:5178
PUBLIC_BASE_URL=http://127.0.0.1:8000
OAUTH_CONSENT_URL=
# 留白＝不開啟站上長期記憶，也不會使用社區的嵌入金鑰。
EMBED_OPENAI_API_KEY=
INTERNAL_SECRET=
# UPLOADS_DIR、MEM0_QDRANT_PATH、MEM0_HISTORY_DB 預設跟隨這份 backend 目錄。
# 若同一份程式跑多個環境，必須為每個環境另外設定上述路徑與 PHOTO_DIR。
